SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=wms_db
DB_USER=wms_user
DB_PASSWORD=wms_password
DB_HOST=localhost
DB_PORT=5432
DB_HOST_DOCKER=db

# Load balancer / reverse proxy
# HTTPS orqali ishlaganda True qiling (secure cookie'lar yoqiladi)
USE_HTTPS=False
# Masalan: https://wms.example.com,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
# DB ulanishini qayta ishlatish vaqti (soniya)
DB_CONN_MAX_AGE=60

# Gunicorn (har bir replika uchun)
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
